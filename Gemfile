  gem "jekyll-regex-replace"
  gem "jekyll-scholar", "~> 7.1"
  gem "jekyll-sitemap", "~> 1.4"
  gem "jekyll-socials"
end

group :other_plugins do
  gem "css_parser"
  gem "observer"
  gem "ostruct"
  gem "webrick", "~> 1.9"
end

